# Copie este arquivo para .env e preencha. O .env está no .gitignore.

# Adzuna — https://developer.adzuna.com (obrigatório para a fonte Adzuna)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# JSearch via RapidAPI — https://rapidapi.com (opcional; sem ela a fonte é pulada)
RAPIDAPI_KEY=

# Opcional: caminho de saída do JSON (padrão: docs/data/vagas.json)
# VAGAS_JSON_PATH=docs/data/vagas.json

# Opcional: porta local do painel no docker compose (padrão 8080)
# PAINEL_PORTA=8080
